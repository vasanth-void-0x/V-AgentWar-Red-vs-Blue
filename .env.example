# V-AgentWar — RED vs BLUE
# Copy this file to .env and change values for your local environment.
# Never commit real API keys or secrets.

APP_NAME=V-AgentWar
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Persistence
DATABASE_URL=sqlite:///./data/agentwar.db

# V-Core
VCORE_MAX_ROUNDS=10
VCORE_EVENT_HISTORY=200
VCORE_SAFE_MODE=true

# LLM (optional; project must still boot without a key)
LLM_ENABLED=false
LLM_PROVIDER=groq
LLM_MODEL=
LLM_API_KEY=

# RAG / memory
RAG_ENABLED=true
RAG_KNOWLEDGE_DIR=../knowledge
RAG_TOP_K=4

# MCP / capability gateway
MCP_ENABLED=true
MCP_SERVER_NAME=v-agentwar-mcp
MCP_AUDIT_ENABLED=true

# Isolated cyber range
CYBER_RANGE_ENABLED=false
CYBER_RANGE_NETWORK=v_agentwar_range
CYBER_RANGE_TARGET_URL=http://target:3000
ALLOW_EXTERNAL_TARGETS=false

# Defensive integrations (optional)
SURICATA_ENABLED=false
SURICATA_EVE_PATH=
ZEEK_ENABLED=false
ZEEK_LOG_DIR=
WAZUH_ENABLED=false
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/events
